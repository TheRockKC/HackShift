# Server Configuration
PORT=8000
ENVIRONMENT=development
NEON_BRANCH=production

# Database Configuration (PostgreSQL with Psycopg 3 driver)
# For Neon PostgreSQL, use the pooled URL for application queries:
DATABASE_URL=postgresql+psycopg://username:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require

# Direct unpooled URL (recommended for Alembic DDL migrations):
DATABASE_URL_UNPOOLED=postgresql+psycopg://username:password@ep-sample.region.neon.tech/neondb?sslmode=require

# CORS Configuration (Comma-separated list of allowed frontend origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
